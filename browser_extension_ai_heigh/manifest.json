{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "2.1.7",
  "version_name": "2.1.7 ai.heigh.vip no-newapi",
  "description": "__MSG_extDescription__",
  "default_locale": "en",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "tabs",
    "cookies",
    "storage",
    "scripting",
    "alarms",
    "webRequest",
    "debugger",
    "sidePanel"
  ],
  "host_permissions": [
    "http://*/*",
    "ws://*/*",
    "https://*/*",
    "https://labs.google/*",
    "https://*.google.com/*",
    "https://*.googleapis.com/*",
    "https://dreamina.capcut.com/*",
    "https://*.capcut.com/*",
    "https://*.capcutapi.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "FPBrowser2API",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*",
        "https://labs.google/*",
        "https://dreamina.capcut.com/*",
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "content/fpb_config_content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "side_panel": {
    "default_path": "popup.html?panel=1"
  },
  "key": ""
}
